# Copy to .env.local and fill in values:
#   cp .env.example .env.local
#
# Load before running locally:
#   set -a && source .env.local && set +a
#
# For GitHub Actions, paste this file (filled in) into the ENVLOCAL repository secret.

NOTION_TOKEN=
NOTION_DATABASE_ID=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

