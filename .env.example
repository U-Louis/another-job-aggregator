# Copy to .env.local and fill in values:
#   cp .env.example .env.local
#
# Loaded automatically by npm start / npm run test-payload (--env-file=.env.local).
# Or manually: set -a && source .env.local && set +a
#
# For GitHub Actions, paste this file (filled in) into the ENVLOCAL repository secret.

NOTION_TOKEN=
NOTION_DATABASE_ID=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
BRIGHT_DATA_KEY=

# Optional. When set, each newly created Notion card is reviewed with
# configs/agents/review-rules.yaml. Leave empty to skip review.
XAI_API_KEY=

# Optional — defaults to errors.log
# ERROR_LOG_PATH=
